{
  "name": "sessionveil",
  "private": false,
  "version": "0.1.0",
  "description": "Structure-preserving AI coding-agent transcript and MCP trace sanitizer with two-pass correlated redaction",
  "license": "MIT",
  "type": "module",
  "bin": {
    "sessionveil": "./build/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./build/engine/index.d.ts",
      "import": "./build/engine/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:cli": "tsc -p tsconfig.cli.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.cli.json --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "cli": "node --experimental-strip-types src/cli/main.ts",
    "preview": "vite preview",
    "format": "oxfmt"
  },
  "dependencies": {
    "lucide-react": "^1.75.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.76.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
